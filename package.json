{
  "name": "@neuraiproject/neurai-sign-esp32",
  "version": "0.8.1",
  "description": "Create and sign PSBTs for Neurai via ESP32 hardware wallet",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.js"
    },
    "./global": "./dist/NeuraiSignESP32.global.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/*"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.cjs && rollup -c",
    "test": "vitest run && npm run test:types",
    "test:types": "npm run build && tsc -p tsconfig.types-nodenext.json && tsc -p tsconfig.types-node16.json && tsc -p tsconfig.types-bundler.json",
    "test:package": "npm run build && node ./scripts/test-package.mjs && node ./scripts/check-package.mjs",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "config": {
    "minTypeScript": "5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuraiproject/neurai-sign-esp32.git"
  },
  "keywords": [
    "neurai",
    "esp32",
    "hardware-wallet",
    "psbt"
  ],
  "author": "Neurai Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neuraiproject/neurai-sign-esp32/issues"
  },
  "homepage": "https://github.com/neuraiproject/neurai-sign-esp32#readme",
  "dependencies": {
    "@bitcoinerlab/secp256k1": "1.2.0",
    "@neuraiproject/neurai-create-transaction": "^0.9.3",
    "bech32": "^2.0.0",
    "bitcoinjs-lib": "7.0.1",
    "buffer": "^6.0.3",
    "ecpair": "3.0.1",
    "varuint-bitcoin": "2.0.0"
  },
  "devDependencies": {
    "@neuraiproject/neurai-depin-msg": "^3.1.3",
    "@noble/post-quantum": "^0.6.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^20.17.30",
    "@types/w3c-web-serial": "^1.0.8",
    "rollup": "^4.52.4",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
